# Copia este archivo como ".env" y rellena tus datos. NUNCA subas el .env a GitHub.

# Token del bot (Discord Developer Portal > Bot > Reset Token)
TOKEN=pega_aqui_el_token_del_bot

# Canal donde se registran los mensajes borrados. Su servidor es el único donde se auditan mensajes.
ADMIN_LOG_CHANNEL_ID=0

# Mensajes recientes que se guardan en memoria para los logs
CACHE_MAX=5000

# Auditoría: segundos que se espera antes de consultar quién borró, y antigüedad máxima aceptada
AUDIT_WAIT_SECONDS=1.2
AUDIT_LOOKBACK_SECONDS=10

# Música
MAX_QUEUE_SIZE=50
DEFAULT_VOLUME=0.5
# Segundos sin nada que reproducir antes de salir del canal de voz
INACTIVITY_TIMEOUT=300
# Segundos con el canal de voz vacío antes de salir
EMPTY_CHANNEL_TIMEOUT=60
